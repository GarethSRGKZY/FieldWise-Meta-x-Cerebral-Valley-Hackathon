# Copy to .env (same folder) and fill in. The app and the start_glimmer scripts read it
# automatically on Windows, macOS and Linux. Never commit .env (it's gitignored).

# Meta Model API (Muse Spark + SAM 3.1). Keys start with LLM_
MODEL_API_KEY=

# Local Muse Glimmer served by llama.cpp on this laptop.
# GLIMMER_API_KEY is NOT your Meta key: it's a password you make up, shared only between
# the app and the local llama.cpp server. Any random string works.
GLIMMER_BASE_URL=http://127.0.0.1:8080/v1
GLIMMER_API_KEY=change-me-local-only
# Model files for scripts/start_glimmer.* (from scripts/download_glimmer.py)
GLIMMER_GGUF=models/Muse-Glimmer-30B-IQ3_XXS.gguf
GLIMMER_MMPROJ=models/mmproj-Muse-Glimmer-30B-f16.gguf
GLIMMER_NGL=8               # layers on the GPU; raise until llama.cpp runs out of memory, or "auto" to let llama.cpp choose
GLIMMER_CTX=8192
# Small machines (16 GB RAM): load the model into RAM up front, and cap thinking tokens
# GLIMMER_NO_MMAP=1
# GLIMMER_REASONING_BUDGET=128
# GLIMMER_LLAMA_DIR=C:\path\to\llama   # only if llama.cpp is NOT in the project's llama.cpp folder or on PATH
GLIMMER_MODEL=muse-glimmer      # the name the server answers to (-a in the start scripts), NOT a file path
GLIMMER_REASONING_STRENGTH=low
GLIMMER_MAX_TOKENS=4096

# Spark: Standard mode on purpose (Contributor mode lets Meta train on what we send)
SPARK_MODEL=muse-spark-1.3
# SPARK_REASONING_EFFORT=     # leave unset to use the server default

# Routing thresholds: replace with the values bench/analyze.py picks on the dev split
FIELDWISE_QA_THRESHOLD=0.70
FIELDWISE_DX_THRESHOLD=0.70

# Demo safety nets
FIELDWISE_FORCE_OFFLINE=0   # 1 = behave as if there is no connection
FIELDWISE_CACHE_ONLY=0      # 1 = only replay cached Spark/SAM answers, never call the network
# 1 = the hub can't run Glimmer 30B live (e.g. 16 GB laptop): show Glimmer's real outputs recorded by the
#     benchmark run (bench/results/qa_local.jsonl, images_local.jsonl), labelled in the app. Demo only;
#     the benchmark refuses to run with it on. Pick examples with: python bench/demo_examples.py
FIELDWISE_GLIMMER_REPLAY=0

# SAM 3.1 phrase for the leaf; {crop} becomes maize/cassava. Choose with: python bench/sam_phrases.py
FIELDWISE_SAM_LEAF_PHRASE=leaf
# Damaged area inside the leaf: colour (default) or sam. Cut-offs from: python bench/lesion_tune.py
FIELDWISE_LESION_METHOD=colour
FIELDWISE_LESION_HUE_MIN=70
FIELDWISE_LESION_SAT_MIN=0.20
# Show the % only if it passed the test bar (median error <= 15 points); put the measured median error here.
FIELDWISE_SEVERITY_PERCENT=0
FIELDWISE_SEVERITY_ERROR_PTS=

# Where CCMT and PlantSeg are unzipped (default: ./datasets)
# FIELDWISE_DATASETS_DIR=/path/to/datasets
